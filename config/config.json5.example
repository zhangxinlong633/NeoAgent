// Neo agent config example (JSON5 — comments & trailing commas OK).
// Copy to config/config.json5 and adjust.
// Env overrides: NEO_MODEL, NEO_API_KEY, NEO_CONFIG.

{
  model: {
    provider: "openrouter",
    base_url: "https://openrouter.ai/api/v1",
    name: "qwen/qwen3-32b",
    api_key: "YOUR_OPENROUTER_API_KEY",
    max_tokens: 4096,
    temperature: 0.7,
  },

  // soul: { path: "SOUL.md", max_chars: 8000 },

  bootstrap: {
    max_chars_per_file: 8000,
    paths: ["AGENTS.md"],
  },

  rules: {
    max_chars_per_file: 6000,
    paths: [
      "rules/identity.md",
      "rules/response-playbook.md",
    ],
  },

  // workspace: { prompt_cwd: true },

  memory: {
    path: "MEMORY.md",
    max_chars: 4000,
    // Optional local vector recall (default off; no external embedding API):
    // vector: {
    //   enabled: true,
    //   store: ".neo/memory.vdb",
    //   top_k: 5,
    //   dims: 64,
    //   auto_store: { enabled: false, max_chars: 500 }, // heuristic; memory_add tool when enabled
    // },
  },

  session: {
    max_turns: 10,
  },

  // Optional same-session roles for CLI --role NAME (shared -S history):
  // roles: {
  //   researcher: {
  //     description: "调研",
  //     prompt: "本轮只做调研：列事实与待核实点；不要写终稿。",
  //   },
  //   writer: {
  //     prompt: "本轮只写面向用户的终稿；沿用历史调研结论。",
  //   },
  // },

  capability_matrix: {
    enabled: true,
    root: ".",
    // Default pack: capabilities/{local,git,unix} via capabilities/manifest.json5.
    // See docs/examples.md §1.1「开箱组合」.
    directory: "capabilities",
    max_rounds: 16,
    shell_enabled: false,
    // Optional HTTPS fetch (builtin http_get). Hosts are exact match, case-insensitive:
    // http_fetch_enabled: true,
    // http_allow_hosts: "baidu.com,www.baidu.com",
    // http_fetch_max_bytes: 65536,

    // Optional Blender MCP (stdio) — NOT on by default. Needs local Blender + addon
    // (e.g. community bridge https://github.com/ahujasid/blender-mcp via `uvx blender-mcp`).
    // Prefer headless capabilities: blender_cup / blender_product_turntable / blender_export_glb.
    // Warning: bridges often expose execute_code-like tools; Neo does not filter MCP tool names.
    // See example/usage/blender-mcp.md. Set BLENDER_HOST/PORT in the shell if needed (no mcp env yet).
    // mcp_servers: [
    //   {
    //     name: "blender",
    //     command: "uvx", // or absolute path to uvx
    //     args: ["blender-mcp"],
    //     enabled: true,
    //   },
    // ],
  },

  // Default pack: dags/{baseline,workspace}. Flagship SOP: workspace_brief.
  dag_directory: "dags",

  // plan: { target_steps: 10 },
}
