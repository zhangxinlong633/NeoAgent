// Demo Neo loading example/ soul, bootstrap, rules, memory (run from repo root).
// Usage: ./neo -c example/neo-claw-example.json5 "你是谁"
// Paths are relative to cwd. Run from neoclaw root with -c.

{
  model: {
    provider: "openrouter",
    base_url: "https://openrouter.ai/api/v1",
    name: "qwen/qwen3-8b",
    api_key: "YOUR_OPENROUTER_API_KEY",
    max_tokens: 2048,
    temperature: 0.7,
  },

  workspace: { prompt_cwd: true },

  soul: { path: "example/SOUL.md", max_chars: 4000 },

  bootstrap: {
    max_chars_per_file: 4000,
    paths: ["example/AGENTS.md"],
  },

  rules: {
    max_chars_per_file: 4000,
    paths: [
      "example/RULES.md",
      "rules/identity.md",
      "rules/response-playbook.md",
    ],
  },

  memory: {
    path: "example/MEMORY.md",
    max_chars: 2000,
  },

  capability_matrix: {
    enabled: true,
    root: ".",
    directory: "capabilities",
  },

  dag_directory: "dags",
}
