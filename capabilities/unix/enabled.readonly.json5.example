{
  // 样例：只读诊断白名单（无 curl/ping 等网络写副作用偏好）。
  // 用法：cp enabled.readonly.json5.example enabled.json5 后重启 neo。
  load: [
    "unix_ls",
    "unix_wc",
    "unix_head",
    "unix_tail",
    "unix_file",
    "unix_du",
    "unix_df",
    "unix_find",
    "unix_basename",
    "unix_dirname",
    "unix_realpath",
    "unix_md5",
    "unix_sha256",
    "unix_sort",
    "unix_uniq",
    "unix_cut",
    "unix_base64",
    "unix_hostname",
    "unix_whoami",
    "unix_id",
    "unix_uptime",
    "unix_ps",
    "unix_sysctl_hw",
    "unix_vm_stat",
    "unix_cal",
    "unix_true",
    "unix_false",
    "unix_seq",
    "unix_printf",
    "unix_od",
    "unix_sed",
    "unix_cksum",
    "unix_uname_s",
  ],
}
